{
  "name": "expense-service",
  "version": "1.0.0",
  "description": "SplitPay Expense Service — groups, expenses, splits, settlements",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "dev": "node --watch --env-file=.env src/index.js",
    "test": "node --test tests/",
    "migrate": "node --env-file=.env node_modules/.bin/node-pg-migrate up --migrations-table pgmigrations_expense",
    "migrate:down": "node --env-file=.env node_modules/.bin/node-pg-migrate down --migrations-table pgmigrations_expense",
    "migrate:create": "node-pg-migrate create"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^7.7.1",
    "pg": "^8.11.5",
    "zod": "^3.23.8"
  }
}
