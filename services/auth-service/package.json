{
  "name": "auth-service",
  "version": "1.0.0",
  "description": "SplitPay Auth Service — handles registration, login, and JWT tokens",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "dev": "node --watch --env-file=.env src/index.js",
    "test": "node --test tests/",
    "migrate": "node --env-file=.env node_modules/.bin/node-pg-migrate up",
    "migrate:down": "node --env-file=.env node_modules/.bin/node-pg-migrate down",
    "migrate:create": "node-pg-migrate create"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  }
}
